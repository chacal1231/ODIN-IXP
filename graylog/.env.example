# Copy to .env; never commit runtime values.
# Existing installations: preserve GRAYLOG_PASSWORD_SECRET; do not regenerate it.
GRAYLOG_PASSWORD_SECRET=
GRAYLOG_ROOT_PASSWORD_SHA2=
GRAYLOG_TIMEZONE=America/Bogota
GRAYLOG_HTTP_EXTERNAL_URI=http://localhost:9000/
# Web/API is local by default. Use an authenticated TLS reverse proxy or SSH tunnel.
GRAYLOG_HTTP_BIND=127.0.0.1
OPENSEARCH_JAVA_OPTS=-Xms8g -Xmx8g
MONGO_VERSION=7.0
