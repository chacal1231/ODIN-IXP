# Inject into the OpenClaw tool process outside prompts and Skills.
GRAYLOG_URL=https://graylog.example.invalid/api
GRAYLOG_TOKEN=
# Required by graylog_query.py; exact Graylog source names, comma-separated.
GRAYLOG_ALLOWED_SOURCES=
LIBRENMS_URL=https://librenms.example.invalid/api/v0
LIBRENMS_TOKEN=
# Required by librenms_query.py; exact LibreNMS hostnames, comma-separated ("*" allows all).
LIBRENMS_ALLOWED_DEVICES=
# LibreNMS server time zone for alert/eventlog timestamps. Fixed offset needs no tzdata;
# Colombia has no DST. An IANA name (America/Bogota) also works where tzdata is installed.
LIBRENMS_TIMEZONE=-05:00
# Akvorado ClickHouse, SELECT-only account (readonly profile with max_execution_time/max_rows_to_read).
AKVORADO_URL=https://clickhouse.example.invalid:8443
AKVORADO_USER=odin_readonly
AKVORADO_TOKEN=
# Required by akvorado_query.py; exact ExporterName values, comma-separated ("*" allows all).
AKVORADO_ALLOWED_EXPORTERS=
