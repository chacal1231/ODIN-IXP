# Copiar a .env (ignorado por git) en /opt/pmacct. Cuenta con permiso INSERT solo sobre bmp_events,
# distinta de la cuenta SELECT del agente.
CLICKHOUSE_URL=https://clickhouse.example.invalid:8443/
CLICKHOUSE_USER=bmp_ingester
CLICKHOUSE_PASSWORD=
# Solo en red privada sin TLS; el ingester rechaza HTTP sin esta variable.
# CLICKHOUSE_ALLOW_HTTP=1
CLICKHOUSE_TABLE=bmp_events
CLICKHOUSE_TIMEOUT=10
BMP_FILES=/data/bmp-logs/bmp-events-*.json
BMP_BATCH_SIZE=500
BMP_FLUSH_SECONDS=5
# Solo para archivos sin checkpoint. "end" en la migración desde el ingester anterior
# (evita reinsertar lo ya cargado); "start" en instalaciones nuevas.
BMP_INITIAL_POSITION=start
# Dirección donde pmbmpd escucha BMP; restringir con firewall a los PEs.
BMP_LISTEN=0.0.0.0
